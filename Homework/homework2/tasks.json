{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: Debug",
            "command": "g++",
            "args": [
                "-g",
                "-Wall",
                "-std=c++17",
                "-fsanitize=address",
                "-static-libasan",
                "-D_GLIBCXX_DEBUG",
                "*.cpp",
                "-o",
                "${fileDirname}/${workspaceFolderBasename}",
                "-lboost_system",
                "-lpthread"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}
